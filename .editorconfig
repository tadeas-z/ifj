# Implementation of the IFJ26 imperative language compiler
# .editorconfig
# Author(s): Adam Zatloukal (xzatloa01)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4

# Make recipes must start with a real tab
[Makefile]
indent_style = tab
